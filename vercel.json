{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/assets/lecture/:image",
      "destination": "https://jijeok-class-quiz.hopesound.chatgpt.site/assets/lecture/:image"
    },
    {
      "source": "/api/:path*",
      "destination": "https://jijeok-class-quiz.hopesound.chatgpt.site/api/:path*"
    },
    {
      "source": "/join",
      "destination": "/student.html"
    },
    {
      "source": "/lecture",
      "destination": "/lecture.html"
    }
  ]
}
